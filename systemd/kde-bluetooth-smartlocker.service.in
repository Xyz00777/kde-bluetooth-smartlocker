[Unit]
Description=KDE Bluetooth SmartLocker
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/kde-bluetooth-smartlocker
EnvironmentFile=-%h/.config/kde-bluetooth-smartlocker/service.conf
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=graphical-session.target
